        <mxCell id="edit" value="&lt;b&gt;Edit this hero&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px&quot;&gt;/heroes/{heroId}/edit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=7;fillColor=#eee7fa;strokeColor=#8c72ad;fontColor=#39264e;" vertex="1" parent="1"><mxGeometry x="802" y="140" width="195" height="84" as="geometry"/></mxCell>
        <mxCell id="save" value="&lt;b&gt;Updated hero’s sheet&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px&quot;&gt;/sheet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=7;fillColor=#d6f1e7;strokeColor=#378164;fontColor=#113c2f;" vertex="1" parent="1"><mxGeometry x="802" y="340" width="195" height="84" as="geometry"/></mxCell>
        <mxCell id="gear" value="&lt;b&gt;Equipment chooser&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px&quot;&gt;/equipment/{slot}?heroId=…&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=7;fillColor=#f4f7fa;strokeColor=#99aaba;fontColor=#243747;" vertex="1" parent="1"><mxGeometry x="407" y="340" width="215" height="84" as="geometry"/></mxCell>
        <mxCell id="confirm" value="&lt;b&gt;Confirm removal&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px&quot;&gt;/parties/{partyId}/heroes/{heroId}/remove&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=7;fillColor=#f4f7fa;strokeColor=#99aaba;fontColor=#243747;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="195" height="84" as="geometry"/></mxCell>
