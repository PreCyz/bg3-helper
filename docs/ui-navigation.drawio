        <mxCell id="subtitle" value="Use the portrait or the name in any party. The selection also determines who appears when you next open /sheet." style="text;html=1;align=left;fontFamily=Helvetica;fontSize=15;fontColor=#425d6f;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="970" height="35" as="geometry"/></mxCell>
